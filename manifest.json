{
  "schemaVersion": 1,
  "id": "akash.sing-with-omarchy",
  "name": "Sing with Omarchy",
  "version": "0.2.0",
  "author": "Akash A",
  "license": "MIT",
  "description": "Keep the words close. A synchronized lyrics reader for your desktop.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Session.qml",
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Sing with Omarchy",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "centerLyrics": false
    },
    "schema": [
      {
        "key": "centerLyrics",
        "type": "boolean",
        "label": "Lyrics in center bar",
        "description": "Replace center widgets while synchronized lyrics are playing.",
        "defaultValue": false
      }
    ]
  }
}
